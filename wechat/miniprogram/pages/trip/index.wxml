<view class="page {{snapshot && !snapshot.trip.archived?'with-add':''}}"><view wx:if="{{demo}}" class="demo-banner">演示模式 · 本机数据，与网页版分开</view><view wx:if="{{error}}" class="error">{{error}}<text class="link" bindtap="refresh">　刷新账本</text></view><view wx:if="{{loading}}" class="loading">正在整理账本…</view><block wx:if="{{snapshot}}"><view class="hero"><view class="hero-sun"></view><view class="hero-hill"></view><view class="row between hero-content"><text class="badge">{{snapshot.trip.archived?'已归档 · 只读':'一起旅行中'}}</text><button wx:if="{{owner}}" class="button small ghost" bindtap="settings">设置</button></view><view class="hero-title">{{snapshot.trip.name}}</view><view class="hero-detail">⌁ {{snapshot.trip.destination}}<view>{{snapshot.trip.startDate}} — {{snapshot.trip.endDate}}</view></view><view class="row hero-content"><view class="avatar-stack"><view wx:for="{{snapshot.members}}" wx:key="id" class="avatar">{{item.initial}}</view></view><text class="tiny">{{snapshot.members.length}} 位同行 · {{snapshot.trip.currency}}结算</text></view></view><view class="grid2 stats"><view class="card stat"><text class="muted">旅行总支出</text><view class="amount">{{snapshot.trip.totalText}}</view><text class="tiny">{{snapshot.expenses.length}} 笔共同花费</text></view><view class="card stat"><text class="muted">我的垫付</text><view class="amount">{{paidText}}</view><text class="tiny">为同行垫付的费用</text></view><view class="card stat"><text class="muted">我的分摊</text><view class="amount">{{owedText}}</view><text class="tiny">应承担的消费金额</text></view><view class="card stat green"><text class="muted">{{balanceLabel}}</text><view class="amount teal">{{balanceText}}</view><text class="tiny">已计入实际还款</text></view></view><view wx:if="{{editing}}" class="card"><view class="card-title">旅行设置</view><block wx:if="{{!snapshot.trip.archived}}"><text class="form-label">旅行名称</text><input class="input" maxlength="60" value="{{form.name}}" data-field="name" bindinput="field"/><text class="form-label">目的地</text><input class="input" maxlength="60" value="{{form.destination}}" data-field="destination" bindinput="field"/><view class="grid2"><view><text class="form-label">开始日期</text><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="field"><view class="picker">{{form.startDate}}</view></picker></view><view><text class="form-label">结束日期</text><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="field"><view class="picker">{{form.endDate}}</view></picker></view></view><text class="form-label">结算币种</text><picker range="{{currencyLabels}}" value="{{currencyIndex}}" bindchange="currency" disabled="{{snapshot.trip.currencyLocked}}"><view class="picker">{{currencyLabels[currencyIndex]}}</view></picker><view class="help">{{snapshot.trip.currencyLocked?'币种已锁定':'首笔支出录入后锁定币种'}}</view><button class="button primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveSettings">保存旅行设置</button></block><view class="actions"><button class="button secondary" disabled="{{saving}}" bindtap="archive">{{snapshot.trip.archived?'恢复旅行':'归档旅行'}}</button></view></view><view wx:if="{{owner && !snapshot.trip.archived}}" class="card"><view class="row between"><view><view class="card-title">邀请同行，一起记账</view><view class="tiny">登录后加入，账单仅对成员开放</view></view><button class="button small secondary" disabled="{{saving}}" bindtap="invite">{{inviteToken?'重置链接':'生成邀请'}}</button></view><view wx:if="{{inviteToken}}"><view class="help">{{demo?'演示邀请，仅用于本机体验':'邀请有效期至 ' + inviteExpires + '，重置后旧链接失效。'}}</view><button class="button primary" open-type="share" disabled="{{demo}}">转发邀请给微信好友</button></view></view><view class="tabs"><button class="tab {{tab==='expenses'?'active':''}}" data-tab="expenses" bindtap="tab">账单明细</button><button class="tab {{tab==='settlement'?'active':''}}" data-tab="settlement" bindtap="tab">分账结算</button><button class="tab {{tab==='members'?'active':''}}" data-tab="members" bindtap="tab">同行成员</button></view><block wx:if="{{tab==='expenses'}}"><view class="filters"><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="pickCategory"><view class="pill">{{categories[categoryIndex]}} ▾</view></picker><picker range="{{memberLabels}}" value="{{memberIndex}}" bindchange="pickMember"><view class="pill">{{memberLabels[memberIndex]}} ▾</view></picker><picker mode="date" value="{{filterDate}}" bindchange="pickDate"><view class="pill">{{filterDate || '消费日期'}} ▾</view></picker><text wx:if="{{categoryIndex || memberIndex || filterDate}}" class="link" bindtap="clearFilters">清除</text></view><view wx:if="{{!shownExpenses.length}}" class="card empty"><view class="empty-icon">◌</view><view class="empty-title">{{snapshot.expenses.length?'没有符合筛选的账单':'记下旅程的第一笔花费'}}</view><view class="empty-detail">邀请同行成员，选择实际参与消费的人。</view></view><view wx:for="{{shownExpenses}}" wx:key="id" class="card expense"><view class="row between"><view class="expense-info"><view class="card-title">{{item.title}}</view><view class="muted">{{item.payerName}} 垫付 · {{item.shares.length}} 人均分</view></view><text class="amount">{{item.amountText}}</text></view><view class="row between expense-meta"><text class="tiny">{{item.date}} · {{item.category}}</text><text class="link" data-index="{{index}}" bindtap="toggleShares">{{item.expanded?'收起':'查看分摊'}} ▾</text></view><view wx:if="{{item.expanded}}" class="share-list"><view wx:for="{{item.shares}}" wx:key="userId" wx:for-item="share" class="row between"><text>{{share.name}}</text><text>{{share.amountText}}</text></view></view><view wx:if="{{!snapshot.trip.archived}}" class="record-actions"><button class="button ghost small" data-id="{{item.id}}" bindtap="editExpense">编辑</button><button class="button ghost small delete" disabled="{{saving}}" data-id="{{item.id}}" data-kind="expenses" bindtap="remove">删除</button></view></view></block><block wx:elif="{{tab==='settlement'}}"><view class="section-title">这样转账，就算清了</view><view class="help">根据垫付、分摊和已登记还款自动计算。请在实际转账后登记。</view><view wx:if="{{!snapshot.transfers.length}}" class="card empty"><view class="empty-icon">✓</view><view class="empty-title">大家的账，已经算清了</view><view class="empty-detail">剩下的就是享受旅程。</view></view><view wx:for="{{snapshot.transfers}}" wx:key="key" class="card"><view class="row between"><text>{{item.fromName}} → {{item.toName}}</text><text class="amount teal">{{item.amountText}}</text></view><view class="actions"><button class="button secondary" disabled="{{snapshot.trip.archived}}" data-index="{{index}}" bindtap="recordTransfer">登记实际还款</button></view></view><button class="button secondary" disabled="{{snapshot.trip.archived || snapshot.members.length&lt;2 || !snapshot.expenses.length}}" bindtap="addRepayment">＋ 手动登记还款</button><view class="section-title">还款记录</view><view wx:if="{{!snapshot.repayments.length}}" class="card empty"><view class="empty-detail">还没有实际还款记录</view></view><view wx:for="{{snapshot.repayments}}" wx:key="id" class="card"><view class="row between"><view><view class="card-title">{{item.fromName}} → {{item.toName}}</view><text class="tiny">{{item.date}}</text></view><text class="amount">{{item.amountText}}</text></view><view wx:if="{{!snapshot.trip.archived}}" class="record-actions"><button class="button ghost small" data-id="{{item.id}}" bindtap="editRepayment">修改</button><button class="button ghost small delete" disabled="{{saving}}" data-id="{{item.id}}" data-kind="repayments" bindtap="remove">撤销</button></view></view></block><block wx:else><view class="help">全体成员共同管理账单与还款，正余额表示待收款。</view><view wx:for="{{snapshot.members}}" wx:key="id" class="card"><view class="row"><view class="avatar">{{item.initial}}</view><view><view class="card-title">{{item.name}} <text wx:if="{{item.mine}}" class="badge">我</text></view><text class="tiny">{{item.id===snapshot.trip.ownerId?'旅行创建者':'同行成员'}}</text></view></view><view class="member-stats"><view><text class="tiny">已垫付</text><view>{{item.paidText}}</view></view><view><text class="tiny">应分摊</text><view>{{item.owedText}}</view></view><view><text class="tiny">当前余额</text><view class="teal">{{item.balanceText}}</view></view></view></view></block><button wx:if="{{!snapshot.trip.archived}}" class="button primary fixed-add" bindtap="addExpense">＋ 记一笔</button></block></view>
